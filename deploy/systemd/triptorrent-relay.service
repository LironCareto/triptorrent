[Unit]
Description=TripTorrent Testnet v1 relay
After=network-online.target triptorrent-bootstrap.service
Wants=network-online.target

[Service]
User=triptorrent
Group=triptorrent
EnvironmentFile=/etc/triptorrent/relay.env
ExecStart=/usr/local/bin/triptorrent relay --listen 0.0.0.0:7000 --bootstrap ${BOOTSTRAP_ADDRESS} --id ${RELAY_ID} --advertise ${PUBLIC_RELAY_ADDRESS}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
